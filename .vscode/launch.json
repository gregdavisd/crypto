{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js App",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/src",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "serverReadyAction": {
        "pattern": "started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Firebase Functions (Emulator)",
      "type": "node",
      "request": "launch",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/functions/node_modules/.bin/firebase",
      "args": [
        "emulators:start",
        "--only",
        "functions"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Attach to Functions",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "localRoot": "${workspaceFolder}/functions",
      "remoteRoot": "/workspace"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Next.js + Functions)",
      "configurations": [
        "Next.js App",
        "Firebase Functions (Emulator)"
      ],
      "stopAll": true
    }
  ]
}